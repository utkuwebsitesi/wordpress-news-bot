msgid "Choose language, tone and content length from the Settings page."
msgstr "Dil, ton ve içerik uzunluğunu Ayarlar sayfasından seçin."
msgid "Safe defaults: 25 AI news items per day and 5 items per run."
msgstr "Güvenli varsayılanlar: günde 25 AI haberi ve çalıştırma başına 5 kayıt."
msgid "Your settings can be changed at any time. Generated posts always remain drafts."
msgstr "Ayarlarınızı istediğiniz zaman değiştirebilirsiniz. Üretilen yazılar daima taslak olarak kalır."
msgid "The source URL did not pass security validation."
msgstr "Kaynak URL güvenlik doğrulamasından geçmedi."
msgid "You do not have permission to access this page."
msgstr "Bu sayfaya erişim yetkiniz yok."
msgid "Invalid security token."
msgstr "Güvenlik doğrulaması geçersiz."
msgid "Invalid request."
msgstr "İstek geçersiz."
msgid "API key cannot be empty."
msgstr "API anahtarı boş bırakılamaz."
msgid "The encrypted API key could not be saved."
msgstr "Şifreli API anahtarı kaydedilemedi."
msgid "Secure encryption is unavailable on this server. The API key was not saved."
msgstr "Bu sunucuda güvenli şifreleme desteği bulunamadı. API anahtarı kaydedilmedi."
msgid "The API key could not be encrypted."
msgstr "API anahtarı şifrelenemedi."
msgid "The OpenAI API key is not configured."
msgstr "OpenAI API anahtarı yapılandırılmamış."
msgid "Could not connect to OpenAI."
msgstr "OpenAI sunucusuna bağlanılamadı."
msgid "The API key could not be verified."
msgstr "API anahtarı doğrulanamadı."
msgid "The OpenAI usage limit was reached. Please try again later."
msgstr "OpenAI kullanım limiti aşıldı. Lütfen daha sonra yeniden deneyin."
msgid "The OpenAI connection test could not be completed."
msgstr "OpenAI bağlantı testi tamamlanamadı."
msgid "The OpenAI response could not be read."
msgstr "OpenAI yanıtı okunamadı."
msgid "The model refused the connection test."
msgstr "Model bağlantı testini reddetti."
msgid "OpenAI did not return valid structured output."
msgstr "OpenAI geçerli yapılandırılmış çıktı döndürmedi."

