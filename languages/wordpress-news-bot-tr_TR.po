msgstr "Test Kimliği: %s"
msgid "The source did not pass the security check. Check the RSS URL and redirect domains."
msgstr "Kaynak güvenlik kontrolünden geçmedi. RSS URL'sini ve yönlendirme alan adlarını kontrol edin."
msgid "The source server could not be reached. Please try again."
msgstr "Kaynak sunucuya ulaşılamadı. Lütfen yeniden deneyin."
msgid "The source returned an invalid HTTP response."
msgstr "Kaynak geçersiz bir HTTP yanıtı verdi."
msgid "The response is not in RSS/Atom format."
msgstr "Yanıt RSS/Atom biçiminde değil."
msgid "The source returned an empty response."
msgstr "Kaynak boş bir yanıt döndürdü."
msgid "The source XML could not be parsed."
msgstr "Kaynak XML'i ayrıştırılamadı."
msgid "The source could not be saved to the database."
msgstr "Kaynak veritabanına kaydedilemedi."
msgid "Dismiss this notice"
msgstr "Bu bildirimi kapat"
msgid "The source details did not pass security validation."
msgstr "Kaynak bilgileri güvenlik doğrulamasından geçemedi. RSS URL'sini kontrol edin."
msgid "Database Health"
msgstr "Veritabanı Sağlığı"
msgid "Healthy"
msgstr "Sağlıklı"
msgid "Repair required"
msgstr "Onarım gerekli"
msgid "Repair Database"
msgstr "Veritabanını Onar"
